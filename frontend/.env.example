# Copy to .env and adjust. Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the backend REST API. In development, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api/v1

# Google OAuth 2.0 client ID (placeholder, ask the team for the real one).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps browser key for the GeoGuesser's Street View and maps (Maps JavaScript API). Not the
# backend's server key: restrict this one to the Maps JavaScript API and to the site's address
# (http://localhost:5173/* in development). Without it, the GeoGuesser shows a message instead.
VITE_GOOGLE_MAPS_BROWSER_KEY=
