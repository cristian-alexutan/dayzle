# Copy to .env and adjust. Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the backend REST API. In development, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api/v1

# Google OAuth 2.0 client ID (placeholder, ask the team for the real one).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
