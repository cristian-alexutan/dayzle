{
  "name": "dayzle-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "type-check": "vue-tsc --build",
    "generate:api": "openapi-typescript ${API_SCHEMA_URL:-http://localhost:8000/api/schema/} -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@primeuix/themes": "3.1.0",
    "@tanstack/vue-query": "5.104.5",
    "leaflet": "1.9.4",
    "pinia": "4.1.0",
    "primevue": "5.0.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
