# Copy to .env and adjust. docker-compose.yml reads this file.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL (used by the db container)
POSTGRES_DB=dayzle
POSTGRES_USER=dayzle
POSTGRES_PASSWORD=dayzle

# Database URL used by Django. Host is "db" inside docker compose;
# use "localhost" when running Django directly on your machine.
DATABASE_URL=postgres://dayzle:dayzle@db:5432/dayzle

# Google Maps server key for the GeoGuesser (Street View Metadata API), used only by the
# backend to generate and recheck locations. Restrict it to the Street View Static API.
# Leave empty to skip the Geo game in seed_dev.
GOOGLE_MAPS_SERVER_KEY=
